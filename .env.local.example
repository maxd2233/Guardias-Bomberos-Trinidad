NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role de Supabase (Settings -> API). Se usa SOLO en el servidor
# (server actions) para escribir turnos vía funciones RPC. NUNCA se expone al
# navegador; no debe empezar con "sb_publishable_".
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar las cookies de sesión (mínimo 32 caracteres).
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Secreto del cron job de Vercel (mínimo 16 caracteres). Vercel lo envía como
# "Authorization: Bearer <CRON_SECRET>" al invocar /api/cron/generar-turnos.
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
